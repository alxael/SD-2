{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Single Go File",
      "type": "shell",
      "command": "bash",
      "args": ["-c", "go build -o bin/${fileBasenameNoExtension} ${file}"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Build Go Package",
      "type": "shell",
      "command": "bash",
      "args": ["-c", "cd ${fileDirname} && go build -o ${workspaceFolder}/bin/$(basename ${fileDirname}) ."],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
